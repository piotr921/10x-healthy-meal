---
import Layout from '@/layouts/Layout.astro';
import { RestorePasswordForm } from '@/components/auth/RestorePasswordForm';
---

<Layout title="Restore Password - HealthyMeal">
  <div class="min-h-screen flex items-center justify-center bg-muted/30 px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-block">
          <h1 class="text-4xl font-bold text-primary mb-2">HealthyMeal</h1>
        </a>
        <h2 class="text-2xl font-semibold text-foreground mb-2">Restore your password</h2>
        <p class="text-muted-foreground">We'll send you a link to reset your password</p>
      </div>

      <div class="bg-white p-8 rounded-lg border shadow-sm">
        <RestorePasswordForm client:load />
      </div>
    </div>
  </div>
</Layout>

