---
import Layout from '@/layouts/Layout.astro';
import { UpdatePasswordForm } from '@/components/auth/UpdatePasswordForm';
---

<Layout title="Update Password - HealthyMeal">
  <div class="min-h-screen flex items-center justify-center bg-muted/30 px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-block">
          <h1 class="text-4xl font-bold text-primary mb-2">HealthyMeal</h1>
        </a>
        <h2 class="text-2xl font-semibold text-foreground mb-2">Update your password</h2>
        <p class="text-muted-foreground">Enter your new password below</p>
      </div>

      <div class="bg-white p-8 rounded-lg border shadow-sm">
        <UpdatePasswordForm client:load />
      </div>
    </div>
  </div>
</Layout>

