---
import { UserNav } from '@/components/auth/UserNav';

// Check if user is authenticated
const isLoggedIn = !!Astro.locals.user;
---

<header class="border-b bg-white shadow-sm">
  <div class="container mx-auto px-4 py-4">
    <nav class="flex justify-between items-center">
      <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold text-primary hover:opacity-80 transition-opacity">
          HealthyMeal
        </a>
        {isLoggedIn && (
          <div class="hidden md:flex items-center gap-6">
            <a href="/app/recipes" class="text-sm font-medium hover:text-primary transition-colors">
              My Recipes
            </a>
            <a href="/app/profile/preferences" class="text-sm font-medium hover:text-primary transition-colors">
              Dietary Preferences
            </a>
          </div>
        )}
      </div>
      <UserNav isLoggedIn={isLoggedIn} client:load />
    </nav>
  </div>
</header>

